# --- LLM provider (LLMService abstraction, see backend/app/integrations/llm) ---
# provider=anthropic|gemini|groq.
# gemini: LLM_MODEL e.g. gemini-flash-latest.
# groq: LLM_MODEL e.g. qwen/qwen3.8-27b (see console.groq.com for the current catalog).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Voice input (optional, P1) ---
# Local, multilingual speech-to-text via faster-whisper — see
# backend/app/integrations/whisper/voice_service.py. No API key needed;
# model weights download/cache on first use. tiny|base|small|medium|large-v3.
WHISPER_MODEL_SIZE=small

# --- Memory: Cognee Cloud (semantic/contextual memory layer) ---
# Not the source of truth for transactions/policy/case state — see
# docs/architecture.md. Redeem the HACKBRIVEN hackathon credit at
# https://platform.cognee.ai/billing to get COGNEE_API_KEY and your tenant's
# COGNEE_BASE_URL (e.g. https://your-tenant.aws.cognee.ai). Leaving either
# blank runs the app with Cognee disabled — the rest of Nishchint is
# unaffected (see MemoryService fallback behavior).
COGNEE_ENABLED=true
COGNEE_API_KEY=
COGNEE_BASE_URL=
COGNEE_DATASET=nishchint_memory

# --- Database ---
DATABASE_URL=sqlite:///./nishchint.db

# --- n8n ---
N8N_BASE_URL=
N8N_WEBHOOK_URL=
N8N_API_KEY=
# Shared secret n8n must send back on the followup-result callback
N8N_CALLBACK_SECRET=change-me

# --- App ---
APP_ENV=development
SIMULATION_MODE=true
HIGH_VALUE_THRESHOLD=50000
BACKEND_BASE_URL=http://localhost:8000
# Comma-separated frontend origin(s), or "*" for local dev. Set this to the
# real deployed frontend URL(s) in any non-local environment.
CORS_ALLOW_ORIGINS=*

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
