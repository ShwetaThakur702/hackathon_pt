# Production Environment Variables (Set these in Railway dashboard)

# LLM Provider
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-... # Your Anthropic API key
LLM_MODEL=claude-sonnet-5

# Whisper (speech-to-text)
WHISPER_MODEL_SIZE=small

# Cognee Memory (optional)
COGNEE_ENABLED=true
COGNEE_API_KEY=... # Your Cognee API key
COGNEE_BASE_URL=https://your-tenant.aws.cognee.ai
COGNEE_DATASET=nishchint_memory

# Database - Railway auto-provides this
DATABASE_URL=postgresql://user:password@host/railway

# n8n Workflows (if using)
N8N_BASE_URL=https://your-n8n-instance.com
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/
N8N_API_KEY=... # Your n8n API key
N8N_CALLBACK_SECRET=your-secret

# App Settings
APP_ENV=production
SIMULATION_MODE=false
HIGH_VALUE_THRESHOLD=50000
BACKEND_BASE_URL=https://your-railway-backend-url.up.railway.app
CORS_ALLOW_ORIGINS=https://your-vercel-frontend-url.vercel.app
